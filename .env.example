# Duet example environment. Copy to `.env` and fill in:
#   cp .env.example .env
# `.env` is git-ignored; this file is safe to commit (placeholders only).
# All values have working defaults — an empty `.env` means:
# P2P-only WebRTC (no TURN), open CORS (dev), web on :8080, signal on :8787.

# --- signal (signal-node + signal-cf share these names) ---

# signal-node listen port (Cloudflare ignores this).
PORT=8787

# Comma-separated CORS allowlist, e.g. https://your-app.vercel.app.
# Empty = '*' (dev only — set this in prod).
ALLOWED_ORIGINS=

# Comma-separated TURN URLs. Empty = Metered's public demo relay
# (no signup, best-effort). Set "none" for strict P2P-only mode.
# e.g. TURN_URLS=turn:openrelay.example:3478 for your own relay.
TURN_URLS=

# Time-limited REST credential secret (preferred; keep out of git —
# use `wrangler secret put` on Cloudflare, Render secret env, or `.env`).
TURN_SECRET=

# Static TURN auth alternative (only used when TURN_SECRET is unset).
TURN_USERNAME=
TURN_PASSWORD=

# TURN credential lifetime, seconds.
TURN_TTL_SECONDS=86400

# Max TURN credentials minted per day (hard cap, both backends).
ICE_DAILY_CAP=200

# Gates /api/ice (the money endpoint). Empty = open (dev default).
# When set, callers without it get the P2P-only body (no quota consumed).
# Generate: openssl rand -hex 32. Set as secret, never commit.
SIGNAL_API_KEY=

# --- web (Vite build-time; bake with `docker compose build --build-arg` or export before `npm run build`) ---

# Override signaling origin, e.g. wss://signal.example.com.
# Empty = same-origin (compose nginx proxies /api + /room to signal).
VITE_SIGNAL_URL=

# Reserved for M3 (Share negotiation): sent as `Authorization: Bearer`
# on /api/ice. Baked into the bundle = public by definition; daily caps
# + IP limits remain the real backstop. Leave empty for now.
VITE_SIGNAL_KEY=

# --- compose host ports (no app effect, mapping only) ---

WEB_PORT=8080
SIGNAL_PORT=8787
